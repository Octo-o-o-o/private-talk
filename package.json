{
  "name": "private-talk",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first lightweight desktop toolkit for LLM chat, TTS, and OpenClaw Agent debugging.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Octo-o-o-o/private-talk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octo-o-o-o/private-talk.git"
  },
  "bugs": {
    "url": "https://github.com/Octo-o-o-o/private-talk/issues"
  },
  "keywords": [
    "tauri",
    "react",
    "llm",
    "tts",
    "openclaw",
    "desktop"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "mobile:setup": "node tools/mobile-toolchain/setup.mjs",
    "android:init": "node tools/mobile-toolchain/setup.mjs android && node tools/mobile-toolchain/run-tauri.mjs android init --ci",
    "android:build": "node tools/mobile-toolchain/build-android.mjs",
    "ios:init": "node tools/mobile-toolchain/setup.mjs ios && node tools/mobile-toolchain/run-tauri.mjs ios init",
    "ios:build": "node tools/mobile-toolchain/build-ios.mjs",
    "ios:build:device": "node tools/mobile-toolchain/build-ios.mjs --target aarch64",
    "mac:build": "node tools/mobile-toolchain/build-macos.mjs",
    "package:all": "pnpm mac:build && pnpm ios:build:device && pnpm android:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "pnpm test && pnpm test:rust"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.1",
    "jsdom": "^29.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.1"
  }
}
