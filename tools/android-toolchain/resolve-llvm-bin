#!/bin/zsh
set -euo pipefail

sdk_root="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
ndk_root="${NDK_HOME:-${ANDROID_NDK_HOME:-}}"

if [[ -z "${ndk_root}" ]]; then
  latest_ndk="$(find "$sdk_root/ndk" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort -V | tail -1)"
  if [[ -n "${latest_ndk}" ]]; then
    ndk_root="${latest_ndk}"
  fi
fi

if [[ -z "${ndk_root}" ]]; then
  echo "Android NDK was not found. Set NDK_HOME or install it under $sdk_root/ndk." >&2
  exit 1
fi

toolchain_root="$(find "$ndk_root/toolchains/llvm/prebuilt" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | head -n 1)"
if [[ -z "${toolchain_root}" ]]; then
  echo "Android LLVM toolchain was not found under $ndk_root/toolchains/llvm/prebuilt." >&2
  exit 1
fi

echo "$toolchain_root/bin"
